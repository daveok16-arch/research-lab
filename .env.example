# Environment configuration for the web application.
# Copy to .env and fill in. Never commit a real .env file.

# Session signing key. REQUIRED in production. Sessions do not survive a restart without it.
SECRET_KEY=

# Path to the SQLite database holding intelligence and application data.
OPPINTEL_DB=data/oppintel.db

# Public base URL, used for canonical links, Open Graph tags and the sitemap.
BASE_URL=https://example.com

# Set false only for local development. Controls the Secure cookie flag.
SESSION_COOKIE_SECURE=true

# Set true only for local development.
FLASK_DEBUG=false

# Number of distinct opportunities a free account may view before being asked to sign up.
# 0 disables the limit, which is the MVP default.
FREE_VIEW_LIMIT=0

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Development server bind address (production uses a WSGI server instead).
HOST=127.0.0.1
PORT=5000
